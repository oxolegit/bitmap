{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/s/:seed", "destination": "/api/share?seed=:seed" }
  ],
  "functions": {
    "api/share.js": { "includeFiles": "index.html" }
  },
  "headers": [
    {
      "source": "/(.*)\\.(js|css)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }]
    },
    {
      "source": "/img/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
